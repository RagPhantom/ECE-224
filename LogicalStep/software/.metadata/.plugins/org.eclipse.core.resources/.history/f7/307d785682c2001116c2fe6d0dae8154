#include <stdio.h>
#include <system.h>
#include "altera_avalon_pio_regs.h"

#define EGM_BUSY 1
#define EGM_PERIOD 2
#define EGM_PULSE_WIDTH 3
#define EGM_AVERAGE_LATENCY 4
#define EGM_MISSED 5
#define EGM_MULTI 6

int period = 200;
int pulse_width = 100;
int enable = 1;
int missed_pulses = 0;
int multi_pulses = 0;
int average_latency = 0;


int main()
{

	IOWR(EGM_BASE, 0, 1);
	IOWR(EGM_BASE, EGM_PERIOD, period);
	IOWR(EGM_BASE, EGM_PERIOD, pulse_width);

	while(1) {
		int busy = IORD(EGM_BASE, EGM_BUSY);

		if (busy == 0) {
			// record values
			missed_pulses = IORD(EGM_BASE, EGM_MISSED);
			multi_pulses = IORD(EGM_BASE, EGM_MULTI);
			average_latency = IORD(EGM_BASE, EGM_AVERAGE_LATENCY);
			IOWR(EGM_BASE, 0, 0);
			IOWR(EGM_BASE, 0, 1);
		}
	}

  printf("Hello from Nios II!\n");
  printf("%d\n", busy);


  return 0;
}

