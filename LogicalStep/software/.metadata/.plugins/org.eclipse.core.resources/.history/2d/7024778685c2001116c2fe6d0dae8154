#include <stdio.h>
#include <system.h>
#include "altera_avalon_pio_regs.h"

#define EGM_BUSY 1
#define EGM_PERIOD 2
#define EGM_PULSE_WIDTH 3
#define EGM_AVERAGE_LATENCY 4
#define EGM_MISSED 5
#define EGM_MULTI 6

int enable = 1;
int missed_pulses = 0;
int multi_pulses = 0;
int average_latency = 0;


int main()
{

	IOWR(EGM_BASE, 0, 1);

	alt_irq_register( BUTTON_PIO_IRQ, (void *)0, ISR);

	// background task and experiments
	for (int period = 2; period <= 4000; period += 2 ) {
		IOWR(EGM_BASE, EGM_PERIOD, period);
		IOWR(EGM_BASE, EGM_PERIOD, period/2);
		printf("period: %d\n", period);

		while(1) {
			int busy = IORD(EGM_BASE, EGM_BUSY);
			if (busy == 0) {
				// record values
				missed_pulses = IORD(EGM_BASE, EGM_MISSED);
				multi_pulses = IORD(EGM_BASE, EGM_MULTI);
				average_latency = IORD(EGM_BASE, EGM_AVERAGE_LATENCY);
				printf("missed_pulses: %d\n multi_pulses: %d\n average_latency: %d\n", missed_pulses, multi_pulses, average_latency);
				IOWR(EGM_BASE, 0, 0);
				IOWR(EGM_BASE, 0, 1);
				break;
			}
		}
	}
  return 0;
}

static void ISR(void *context, alt_u32 id){


}

